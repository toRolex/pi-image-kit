{
  "name": "pi-image-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "Unofficial pi image generation port; local package identifier, not a publication decision",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "extensions",
    "src",
    "skills",
    "vendor",
    "resources.json",
    "scripts/verify-resources.mjs",
    "scripts/run-image-cli.mjs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/image-generate.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "audit:resources": "node scripts/verify-resources.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "1.3.36",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
